# Generated by Rice {{ .Version }} for generation {{ .Generation }}.
# Theme: {{ .Theme.Name }}

[Appearance]
{{- with .GTK.QtStyleOverride }}
style={{ . }}
{{- else }}
style=Fusion
{{- end }}
icon_theme={{ .Icons.Theme }}
standard_dialogs=default
{{- if .Config.Qt.Kvantum }}
custom_palette=false
{{- end }}

[Fonts]
general="{{ .Fonts.UIFamily }},{{ .Fonts.UISize }},-1,5,50,0,0,0,0,0"
fixed="{{ .Fonts.MonoFamily }},{{ .Fonts.MonoSize }},-1,5,50,0,0,0,0,0"

[Interface]
cursor_flash_time=1000
double_click_interval=400
gui_effects=@Invalid()
keyboard_scheme=2
menus_have_icons=true
show_shortcuts_in_context_menus=true
stylesheets=@Invalid()
toolbutton_style=4
underline_shortcut=1
wheel_scroll_lines=3
