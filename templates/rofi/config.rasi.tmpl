/* Generated by Rice {{ .Version }} for generation {{ .Generation }}. */
/* Theme: {{ .Theme.Name }} */

configuration {
    modes: {{ quote (join "," .Rofi.Modes) }};
    show-icons: {{ .Rofi.ShowIcons }};
{{- with (default .Icons.Theme .Rofi.IconTheme) }}
    icon-theme: {{ quote . }};
{{- end }}
{{- with .Rofi.DisplayDrun }}
    display-drun: {{ quote . }};
{{- end }}
    terminal: {{ quote .Commands.Terminal }};
    font: {{ quote (font (.Rofi.Font .Fonts.UIFamily) (.Rofi.Size .Fonts.UISize)) }};
    drun-display-format: "{name}";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    background:      {{ .Colors.Background }};
    background-alt:  {{ .Colors.Surface }};
    surface:         {{ .Colors.SurfaceAlt }};
    foreground:      {{ .Colors.Foreground }};
    muted:           {{ .Colors.Muted }};
    primary:         {{ .Colors.Primary }};
    secondary:       {{ .Colors.Secondary }};
    urgent:          {{ .Colors.Error }};
    on-primary:      {{ contrast .Colors.Primary }};
    transparent:     rgba(0,0,0,0%);
}

window {
    width:            {{ .Rofi.Width }};
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    border:           {{ .UI.BorderWidth }}px;
    border-color:     @primary;
    border-radius:    {{ .UI.Radius }}px;
    background-color: @background;
    cursor:           "default";
}

mainbox {
    enabled:  true;
    spacing:  0px;
    padding:  {{ mul .UI.Padding 2 }}px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    enabled:          true;
    spacing:          {{ .UI.HorizontalPadding }}px;
    padding:          {{ .UI.Padding }}px {{ .UI.HorizontalPadding }}px;
    margin:           0px 0px {{ .UI.Padding }}px 0px;
    border-radius:    {{ .UI.Radius }}px;
    background-color: @background-alt;
    text-color:       @foreground;
    children:         [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color:       @primary;
}

entry {
    background-color:      transparent;
    text-color:            @foreground;
    cursor:                text;
    placeholder:           "Search";
    placeholder-color:     @muted;
}

listview {
    enabled:          true;
    lines:            {{ .Rofi.Lines }};
    columns:          {{ .Rofi.Columns }};
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    spacing:          {{ div .UI.Padding 2 }}px;
    background-color: transparent;
    text-color:       @foreground;
}

element {
    enabled:          true;
    spacing:          {{ .UI.HorizontalPadding }}px;
    padding:          {{ .UI.Padding }}px {{ .UI.HorizontalPadding }}px;
    border-radius:    {{ .UI.Radius }}px;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element selected.normal {
    background-color: @primary;
    text-color:       @on-primary;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @background;
}

element-icon {
    size:             {{ .Rofi.Icons .Icons.Size }}px;
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

message {
    background-color: transparent;
    margin:           {{ .UI.Padding }}px 0px 0px 0px;
}

textbox {
    padding:          {{ .UI.Padding }}px {{ .UI.HorizontalPadding }}px;
    border-radius:    {{ .UI.Radius }}px;
    background-color: @background-alt;
    text-color:       @foreground;
    vertical-align:   0.5;
}

error-message {
    padding:          {{ mul .UI.Padding 2 }}px;
    border-radius:    {{ .UI.Radius }}px;
    background-color: @background;
    text-color:       @urgent;
}
{{- with .Rofi.Extra }}

{{ trim . }}
{{- end }}
