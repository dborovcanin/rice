# Generated by Rice {{ .Version }} for generation {{ .Generation }}.
# Theme: {{ .Theme.Name }}
# Edit ~/.config/rice/config.toml or the theme, then run `rice apply`.

font={{ .Fonts.MonoFamily }}:size={{ .Fonts.MonoSize }}
term={{ .Foot.Term }}
pad={{ .Foot.PadX }}x{{ .Foot.PadY }}
{{- with .Foot.Shell }}
shell={{ . }}
{{- end }}

[cursor]
style={{ .Foot.CursorStyle }}
blink={{ if .Foot.CursorBlink }}yes{{ else }}no{{ end }}
color={{ bare .Terminal.Background }} {{ bare .Terminal.Cursor }}

[scrollback]
lines={{ .Foot.ScrollbackLines }}

[key-bindings]
show-urls-launch=Control+Shift+o

[colors]
alpha={{ float .UI.Opacity }}

foreground={{ bare .Terminal.Foreground }}
background={{ bare .Terminal.Background }}

regular0={{ bare (index .Terminal.Regular 0) }}
regular1={{ bare (index .Terminal.Regular 1) }}
regular2={{ bare (index .Terminal.Regular 2) }}
regular3={{ bare (index .Terminal.Regular 3) }}
regular4={{ bare (index .Terminal.Regular 4) }}
regular5={{ bare (index .Terminal.Regular 5) }}
regular6={{ bare (index .Terminal.Regular 6) }}
regular7={{ bare (index .Terminal.Regular 7) }}

bright0={{ bare (index .Terminal.Bright 0) }}
bright1={{ bare (index .Terminal.Bright 1) }}
bright2={{ bare (index .Terminal.Bright 2) }}
bright3={{ bare (index .Terminal.Bright 3) }}
bright4={{ bare (index .Terminal.Bright 4) }}
bright5={{ bare (index .Terminal.Bright 5) }}
bright6={{ bare (index .Terminal.Bright 6) }}
bright7={{ bare (index .Terminal.Bright 7) }}

selection-foreground={{ bare .Terminal.SelectionForeground }}
selection-background={{ bare .Terminal.SelectionBackground }}
urls={{ bare .Terminal.URL }}
{{- with .Foot.Extra }}

{{ trim . }}
{{- end }}
