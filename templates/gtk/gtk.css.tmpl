/* Generated by Rice {{ .Version }} for generation {{ .Generation }}. */
/* Theme: {{ .Theme.Name }} */

/* libadwaita reads these named colors, so GTK4 applications follow the
   palette. GTK3 applications honour far less of this. */
@define-color accent_color {{ .Colors.Primary }};
@define-color accent_bg_color {{ .Colors.Primary }};
@define-color accent_fg_color {{ contrast .Colors.Primary }};

@define-color window_bg_color {{ .Colors.Background }};
@define-color window_fg_color {{ .Colors.Foreground }};

@define-color view_bg_color {{ .Colors.Background }};
@define-color view_fg_color {{ .Colors.Foreground }};

@define-color headerbar_bg_color {{ .Colors.Surface }};
@define-color headerbar_fg_color {{ .Colors.Foreground }};
@define-color headerbar_border_color {{ .Colors.Border }};

@define-color popover_bg_color {{ .Colors.Surface }};
@define-color popover_fg_color {{ .Colors.Foreground }};

@define-color card_bg_color {{ .Colors.Surface }};
@define-color card_fg_color {{ .Colors.Foreground }};

@define-color dialog_bg_color {{ .Colors.Surface }};
@define-color dialog_fg_color {{ .Colors.Foreground }};

@define-color sidebar_bg_color {{ .Colors.SurfaceAlt }};
@define-color sidebar_fg_color {{ .Colors.Foreground }};

@define-color destructive_bg_color {{ .Colors.Error }};
@define-color destructive_fg_color {{ contrast .Colors.Error }};
@define-color success_bg_color {{ .Colors.Success }};
@define-color success_fg_color {{ contrast .Colors.Success }};
@define-color warning_bg_color {{ .Colors.Warning }};
@define-color warning_fg_color {{ contrast .Colors.Warning }};
@define-color error_bg_color {{ .Colors.Error }};
@define-color error_fg_color {{ contrast .Colors.Error }};

@define-color borders {{ .Colors.Border }};
