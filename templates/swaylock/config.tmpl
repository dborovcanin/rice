# Generated by Rice {{ .Version }} for generation {{ .Generation }}.
# Theme: {{ .Theme.Name }}

{{- with .Swaylock.Image }}
image={{ . }}
scaling={{ $.Swaylock.ScalingMode }}
{{- else }}
color={{ bare .Colors.Background }}
{{- end }}
{{- with .Swaylock.Blur }}
effect-blur={{ . }}
{{- end }}

daemonize
ignore-empty-password
{{- if .Swaylock.ShowFailed }}
show-failed-attempts
{{- end }}
{{- if .Swaylock.Clock }}
clock
timestr=%H:%M
datestr=%a %e %B
{{- end }}

font={{ .Fonts.UIFamily }}
font-size={{ mul .Fonts.UISize 2 }}

indicator
indicator-radius={{ .Swaylock.IndicatorRadius }}
indicator-thickness={{ .Swaylock.IndicatorThickness }}

inside-color={{ bareA (alpha 0.7 .Colors.Surface) }}
inside-clear-color={{ bareA (alpha 0.7 .Colors.Warning) }}
inside-ver-color={{ bareA (alpha 0.7 .Colors.Primary) }}
inside-wrong-color={{ bareA (alpha 0.7 .Colors.Error) }}

ring-color={{ bare .Colors.Border }}
ring-clear-color={{ bare .Colors.Warning }}
ring-ver-color={{ bare .Colors.Primary }}
ring-wrong-color={{ bare .Colors.Error }}

key-hl-color={{ bare .Colors.Secondary }}
bs-hl-color={{ bare .Colors.Error }}
caps-lock-key-hl-color={{ bare .Colors.Warning }}
caps-lock-bs-hl-color={{ bare .Colors.Error }}

line-color={{ bare .Colors.Background }}
line-clear-color={{ bare .Colors.Background }}
line-ver-color={{ bare .Colors.Background }}
line-wrong-color={{ bare .Colors.Background }}

separator-color=00000000

text-color={{ bare .Colors.Foreground }}
text-clear-color={{ bare .Colors.Background }}
text-ver-color={{ bare .Colors.Background }}
text-wrong-color={{ bare .Colors.Background }}
text-caps-lock-color={{ bare .Colors.Warning }}

layout-bg-color={{ bareA (alpha 0.7 .Colors.Surface) }}
layout-border-color={{ bare .Colors.Border }}
layout-text-color={{ bare .Colors.Foreground }}
{{- with .Swaylock.Extra }}

{{ trim . }}
{{- end }}
