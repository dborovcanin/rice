// Generated by Rice {{ .Version }} for generation {{ .Generation }}.
// Theme: {{ .Theme.Name }}
{
  "layer": {{ quote .Waybar.Layer }},
  "position": {{ quote .Waybar.Position }},
  "height": {{ .Waybar.Height }},
  "spacing": {{ .Waybar.Spacing }},
  "modules-left": {{ json .Waybar.ModulesLeft }},
  "modules-center": {{ json .Waybar.ModulesCenter }},
  "modules-right": {{ json .Waybar.ModulesRight }}{{ if .Waybar.Modules }},
{{- $last := sub (len .Waybar.Modules) 1 }}
{{- $i := 0 }}
{{- range $name, $settings := .Waybar.Modules }}
  {{ quote $name }}: {{ jsonIndent 2 $settings }}{{ if lt $i $last }},{{ end }}
{{- $i = add $i 1 }}
{{- end }}
{{- end }}
}
