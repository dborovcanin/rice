/* Generated by Rice {{ .Version }} for generation {{ .Generation }}. */
/* Theme: {{ .Theme.Name }} — neon */
{{- $border := .Waybar.Border.Resolve .Border.Focused }}

@define-color background {{ .Colors.Background }};
@define-color surface {{ .Colors.Surface }};
@define-color surface-alt {{ .Colors.SurfaceAlt }};
@define-color foreground {{ .Colors.Foreground }};
@define-color muted {{ .Colors.Muted }};
@define-color primary {{ .Colors.Primary }};
@define-color secondary {{ .Colors.Secondary }};
@define-color accent {{ .Colors.Accent }};
@define-color success {{ .Colors.Success }};
@define-color warning {{ .Colors.Warning }};
@define-color error {{ .Colors.Error }};
@define-color border {{ $border.Color }};

* {
  font-family: {{ .Fonts.BarFont }}, monospace;
  font-size: {{ .Fonts.BarFontSize }}pt;
  min-height: 0;
  border: none;
  border-radius: 0;
}

/* Dark, with everything that matters glowing in its own colour. */
window#waybar {
  background: {{ (alpha .UI.Opacity .Colors.Background).RGBA }};
  color: @foreground;
}

window#waybar.hidden { opacity: 0.2; }

#workspaces button {
  padding: 0 {{ .UI.HorizontalPadding }}px;
  color: @muted;
  background: transparent;
}

#workspaces button.visible { color: @foreground; }
#workspaces button.focused {
  color: @primary;
  text-shadow: 0 0 8px @primary;
  box-shadow: inset 0 -2px @primary;
}
#workspaces button.urgent { color: @error; text-shadow: 0 0 8px @error; }
#workspaces button:hover { color: @foreground; }

#mode { color: @warning; text-shadow: 0 0 8px @warning; padding: 0 {{ .UI.HorizontalPadding }}px; }
#window { color: @muted; padding: 0 {{ .UI.HorizontalPadding }}px; }

#clock,
#cpu,
#memory,
#disk,
#battery,
#pulseaudio,
#network,
#backlight,
#temperature,
#idle_inhibitor,
#tray {
  padding: 0 {{ .UI.HorizontalPadding }}px;
  margin: {{ div .UI.Padding 2 }}px 2px;
  background: {{ (alpha 0.35 .Colors.Surface).RGBA }};
  border: {{ $border.Width }}px solid @border;
  border-radius: {{ $border.Radius }}px;
}

#cpu { color: @primary; border-color: @primary; text-shadow: 0 0 6px @primary; }
#memory { color: @secondary; border-color: @secondary; text-shadow: 0 0 6px @secondary; }
#disk { color: @accent; border-color: @accent; text-shadow: 0 0 6px @accent; }
#backlight { color: @warning; border-color: @warning; text-shadow: 0 0 6px @warning; }
#temperature { color: @secondary; border-color: @secondary; }
#temperature.critical { color: @error; border-color: @error; text-shadow: 0 0 6px @error; }
#pulseaudio { color: @accent; border-color: @accent; text-shadow: 0 0 6px @accent; }
#pulseaudio.muted { color: @muted; border-color: @muted; text-shadow: none; }
#network { color: @primary; border-color: @primary; }
#network.disconnected { color: @error; border-color: @error; text-shadow: 0 0 6px @error; }
#battery { color: @success; border-color: @success; text-shadow: 0 0 6px @success; }
#battery.warning { color: @warning; border-color: @warning; }
#battery.critical:not(.charging) { color: @error; border-color: @error; text-shadow: 0 0 6px @error; }
#clock { color: @foreground; border-color: @foreground; }
#tray { color: @muted; }
#idle_inhibitor.activated { color: @warning; text-shadow: 0 0 6px @warning; }

tooltip {
  background: @background;
  border: {{ $border.Width }}px solid @primary;
  border-radius: {{ $border.Radius }}px;
}

tooltip label { color: @foreground; }

{{- with .Waybar.ExtraCSS }}

{{ trim . }}
{{- end }}
