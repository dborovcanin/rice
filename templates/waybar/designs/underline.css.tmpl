/* Generated by Rice {{ .Version }} for generation {{ .Generation }}. */
/* Theme: {{ .Theme.Name }} — underline */
{{- $border := .Waybar.Border.Resolve .Border.Focused }}

@define-color background {{ .Colors.Background }};
@define-color surface {{ .Colors.Surface }};
@define-color surface-alt {{ .Colors.SurfaceAlt }};
@define-color foreground {{ .Colors.Foreground }};
@define-color muted {{ .Colors.Muted }};
@define-color primary {{ .Colors.Primary }};
@define-color secondary {{ .Colors.Secondary }};
@define-color accent {{ .Colors.Accent }};
@define-color success {{ .Colors.Success }};
@define-color warning {{ .Colors.Warning }};
@define-color error {{ .Colors.Error }};
@define-color border {{ $border.Color }};

* {
  font-family: {{ .Fonts.BarFont }}, monospace;
  font-size: {{ .Fonts.BarFontSize }}pt;
  min-height: 0;
  border: none;
  border-radius: 0;
}

/* Flat and quiet, with a rule under whatever is worth looking at. */
window#waybar {
  background: {{ (alpha .UI.Opacity .Colors.Background).RGBA }};
  color: @foreground;
}

window#waybar.hidden { opacity: 0.2; }

#workspaces button {
  padding: 0 {{ .UI.HorizontalPadding }}px;
  color: @muted;
  background: transparent;
  box-shadow: inset 0 -{{ $border.Width }}px transparent;
}

#workspaces button.visible { color: @foreground; }
#workspaces button.focused {
  color: @foreground;
  box-shadow: inset 0 -{{ $border.Width }}px @primary;
}
#workspaces button.urgent {
  color: @error;
  box-shadow: inset 0 -{{ $border.Width }}px @error;
}
#workspaces button:hover { color: @foreground; }

#mode { color: @warning; padding: 0 {{ .UI.HorizontalPadding }}px; }
#window { color: @muted; padding: 0 {{ .UI.HorizontalPadding }}px; }

#clock,
#cpu,
#memory,
#disk,
#battery,
#pulseaudio,
#network,
#backlight,
#temperature,
#idle_inhibitor,
#tray {
  padding: 0 {{ .UI.HorizontalPadding }}px;
  margin: {{ div .UI.Padding 2 }}px 0;
  background: transparent;
}

#cpu { color: @primary; box-shadow: inset 0 -{{ $border.Width }}px @primary; }
#memory { color: @secondary; box-shadow: inset 0 -{{ $border.Width }}px @secondary; }
#disk { color: @accent; box-shadow: inset 0 -{{ $border.Width }}px @accent; }
#backlight { color: @warning; box-shadow: inset 0 -{{ $border.Width }}px @warning; }
#temperature { color: @secondary; box-shadow: inset 0 -{{ $border.Width }}px @secondary; }
#temperature.critical { color: @error; box-shadow: inset 0 -{{ $border.Width }}px @error; }
#pulseaudio { color: @accent; box-shadow: inset 0 -{{ $border.Width }}px @accent; }
#pulseaudio.muted { color: @muted; box-shadow: inset 0 -{{ $border.Width }}px @muted; }
#network { color: @primary; box-shadow: inset 0 -{{ $border.Width }}px @primary; }
#network.disconnected { color: @error; box-shadow: inset 0 -{{ $border.Width }}px @error; }
#battery { color: @success; box-shadow: inset 0 -{{ $border.Width }}px @success; }
#battery.warning { color: @warning; box-shadow: inset 0 -{{ $border.Width }}px @warning; }
#battery.critical:not(.charging) { color: @error; box-shadow: inset 0 -{{ $border.Width }}px @error; }
#clock { color: @foreground; box-shadow: inset 0 -{{ $border.Width }}px @foreground; }
#tray { color: @muted; }
#idle_inhibitor.activated { color: @warning; }

tooltip {
  background: @surface;
  border: {{ $border.Width }}px solid @border;
}

tooltip label { color: @foreground; }

{{- with .Waybar.ExtraCSS }}

{{ trim . }}
{{- end }}
