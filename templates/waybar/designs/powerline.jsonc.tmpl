// Generated by Rice {{ .Version }} for generation {{ .Generation }}.
// Theme: {{ .Theme.Name }} — powerline
//
// The arrows are modules rather than shapes, because CSS cannot cut a corner
// off a Waybar module: each one is a glyph the stylesheet colours to match the
// segment beside it. One follows every module on the left, one leads every
// module on the right, and the centre group is capped at both ends.
//
// Spacing is zero whatever the configuration says: an arrow with a gap beside
// it stops being an arrow.
{
  "layer": {{ quote .Waybar.Layer }},
  "position": {{ quote .Waybar.Position }},
  "height": {{ .Waybar.Height }},
  "spacing": 0,
  "modules-left": [
{{- range $i, $m := .Waybar.ModulesLeft }}{{ if $i }},{{ end }}
    {{ quote $m }}, "custom/right-arrow"
{{- end }}
  ],
  "modules-center": [
{{- range $i, $m := .Waybar.ModulesCenter }}{{ if $i }},{{ end }}
    "custom/left-arrow", {{ quote $m }}
{{- end }}
{{- if .Waybar.ModulesCenter }},
    "custom/right-arrow"
{{- end }}
  ],
  "modules-right": [
{{- range $i, $m := .Waybar.ModulesRight }}{{ if $i }},{{ end }}
    "custom/left-arrow", {{ quote $m }}
{{- end }}
  ],
  "custom/left-arrow": {
    "format": "",
    "tooltip": false
  },
  "custom/right-arrow": {
    "format": "",
    "tooltip": false
  }
{{- range $name, $settings := .Waybar.Modules }},
  {{ quote $name }}: {{ jsonIndent 2 $settings }}
{{- end }}
}
