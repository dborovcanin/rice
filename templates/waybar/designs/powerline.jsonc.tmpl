// Generated by Rice {{ .Version }} for generation {{ .Generation }}.
// Theme: {{ .Theme.Name }} — powerline
//
// The arrows are modules rather than shapes, because CSS cannot cut a corner
// off a Waybar module.
//
// A group of modules is one unbroken block: a solid arrow caps each end of it,
// and inside it a thin chevron rules between one module and the next. Nothing
// of the bar shows between two segments — that gap is what makes a powerline
// bar look broken rather than segmented.
//
// The chevrons point the way the block grows. The left group grows rightwards
// from the left edge of the screen, so its chevrons point right; the right
// group grows leftwards from the right edge, so its chevrons point left.
//
// The outermost end of a group is left square: it runs to the edge of the
// screen, and there is nothing beyond it to point at.
//
// Spacing is zero whatever the configuration says: an arrow with a gap beside
// it stops being an arrow.
{
  "layer": {{ quote .Waybar.Layer }},
  "position": {{ quote .Waybar.Position }},
  "height": {{ .Waybar.Height }},
  "spacing": 0,
  "modules-left": [
{{- range $i, $m := .Waybar.ModulesLeft }}{{ if $i }},{{ end }}
    {{ if $i }}"custom/separator-right", {{ end }}{{ quote $m }}
{{- end }}
{{- if .Waybar.ModulesLeft }},
    "custom/arrow-close"
{{- end }}
  ],
  "modules-center": [
{{- range $i, $m := .Waybar.ModulesCenter }}{{ if $i }},{{ end }}
    {{ if $i }}"custom/separator-right"{{ else }}"custom/arrow-open"{{ end }}, {{ quote $m }}
{{- end }}
{{- if .Waybar.ModulesCenter }},
    "custom/arrow-close"
{{- end }}
  ],
  "modules-right": [
{{- range $i, $m := .Waybar.ModulesRight }}{{ if $i }},{{ end }}
    {{ if $i }}"custom/separator-left"{{ else }}"custom/arrow-open"{{ end }}, {{ quote $m }}
{{- end }}
  ],
  "custom/arrow-open": {
    "format": "",
    "tooltip": false
  },
  "custom/arrow-close": {
    "format": "",
    "tooltip": false
  },
  "custom/separator-right": {
    "format": "",
    "tooltip": false
  },
  "custom/separator-left": {
    "format": "",
    "tooltip": false
  }
{{- range $name, $settings := .Waybar.Modules }},
  {{ quote $name }}: {{ jsonIndent 2 $settings }}
{{- end }}
}
