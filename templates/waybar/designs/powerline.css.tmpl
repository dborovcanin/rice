/* Generated by Rice {{ .Version }} for generation {{ .Generation }}. */
/* Theme: {{ .Theme.Name }} — powerline */
{{- $border := .Waybar.Border.Resolve .Border.Focused }}

@define-color background {{ .Colors.Background }};
@define-color surface {{ .Colors.Surface }};
@define-color surface-alt {{ .Colors.SurfaceAlt }};
@define-color foreground {{ .Colors.Foreground }};
@define-color muted {{ .Colors.Muted }};
@define-color primary {{ .Colors.Primary }};
@define-color secondary {{ .Colors.Secondary }};
@define-color accent {{ .Colors.Accent }};
@define-color success {{ .Colors.Success }};
@define-color warning {{ .Colors.Warning }};
@define-color error {{ .Colors.Error }};
@define-color border {{ $border.Color }};
@define-color chip {{ (alpha .UI.Opacity .Colors.Surface).RGBA }};

* {
  font-family: {{ .Fonts.BarFont }}, monospace;
  font-size: {{ .Fonts.BarFontSize }}pt;
  min-height: 0;
  border: none;
  border-radius: 0;
}

/* The bar paints nothing: what you see is the block of segments, and the
   opacity the theme asks for belongs to those rather than to a strip behind
   them. The arrows taper into the wallpaper. */
window#waybar {
  background: transparent;
  color: @foreground;
}

window#waybar.hidden { opacity: 0.2; }

/* A group is one unbroken block. The solid arrows cap its ends, drawn in the
   colour of the block over nothing at all; the thin chevrons rule between two
   modules inside it, and so sit on the block's own colour. They point the way
   the block grows: right from the left edge, left from the right one. */
#custom-arrow-open,
#custom-arrow-close {
  color: @chip;
  background: transparent;
  font-size: {{ add .Fonts.BarFontSize 6 }}pt;
}

#custom-separator-left,
#custom-separator-right {
  color: @muted;
  background: @chip;
  padding: 0 {{ div .UI.HorizontalPadding 2 }}px;
  font-size: {{ add .Fonts.BarFontSize 6 }}pt;
}

#workspaces {
  background: @chip;
  padding: 0 {{ div .UI.HorizontalPadding 2 }}px;
}

#workspaces button {
  padding: 0 {{ .UI.HorizontalPadding }}px;
  color: @muted;
  background: transparent;
}

#workspaces button.visible { color: @foreground; }
#workspaces button.focused { color: @primary; }
#workspaces button.urgent { color: @error; }
#workspaces button:hover { color: @foreground; background: @surface-alt; }

#mode,
#window {
  background: @chip;
  padding: 0 {{ .UI.HorizontalPadding }}px;
  color: @muted;
}

/* Nothing inside a block has a margin: a gap would break the run. */
#workspaces,
#mode,
#window,
#clock,
#cpu,
#memory,
#disk,
#battery,
#pulseaudio,
#network,
#backlight,
#temperature,
#idle_inhibitor,
#tray {
  margin: 0;
  border-radius: 0;
}

#mode { color: @warning; }

#clock,
#cpu,
#memory,
#disk,
#battery,
#pulseaudio,
#network,
#backlight,
#temperature,
#idle_inhibitor,
#tray {
  background: @chip;
  padding: 0 {{ .UI.HorizontalPadding }}px;
}

#cpu { color: @primary; }
#memory { color: @secondary; }
#disk { color: @accent; }
#backlight { color: @warning; }
#temperature { color: @secondary; }
#temperature.critical { color: @error; }
#pulseaudio { color: @accent; }
#pulseaudio.muted { color: @muted; }
#network { color: @primary; }
#network.disconnected { color: @error; }
#battery { color: @success; }
#battery.warning { color: @warning; }
#battery.critical:not(.charging) { color: @error; }
#clock { color: @foreground; }
#tray { color: @muted; }
#idle_inhibitor.activated { color: @warning; }

#battery.critical:not(.charging) {
  color: {{ contrast .Colors.Error }};
  background: @error;
}

tooltip {
  background: @surface;
  border: {{ $border.Width }}px solid @border;
}

tooltip label { color: @foreground; }

{{- with .Waybar.ExtraCSS }}

{{ trim . }}
{{- end }}
