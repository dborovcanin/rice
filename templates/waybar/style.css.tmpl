/* Generated by Rice {{ .Version }} for generation {{ .Generation }}. */
/* Theme: {{ .Theme.Name }} */

@define-color background {{ .Colors.Background }};
@define-color surface {{ .Colors.Surface }};
@define-color surface-alt {{ .Colors.SurfaceAlt }};
@define-color foreground {{ .Colors.Foreground }};
@define-color muted {{ .Colors.Muted }};
@define-color primary {{ .Colors.Primary }};
@define-color secondary {{ .Colors.Secondary }};
@define-color accent {{ .Colors.Accent }};
@define-color success {{ .Colors.Success }};
@define-color warning {{ .Colors.Warning }};
@define-color error {{ .Colors.Error }};

* {
  font-family: {{ .Fonts.BarFont }}, monospace;
  font-size: {{ .Fonts.BarFontSize }}pt;
  min-height: 0;
  border: none;
  border-radius: 0;
}

window#waybar {
  background: {{ (alpha .UI.Opacity .Colors.Background).RGBA }};
  color: @foreground;
}

window#waybar.hidden {
  opacity: 0.2;
}

#workspaces {
  margin: {{ div .UI.Padding 2 }}px {{ .UI.Padding }}px;
}

#workspaces button {
  padding: 0 {{ .UI.HorizontalPadding }}px;
  margin: 0 2px;
  color: @muted;
  background: transparent;
  border-radius: {{ .UI.Radius }}px;
}

#workspaces button.visible {
  color: @foreground;
  background: @surface;
}

#workspaces button.focused {
  color: {{ contrast .Colors.Primary }};
  background: @primary;
}

#workspaces button.urgent {
  color: {{ contrast .Colors.Error }};
  background: @error;
}

#workspaces button:hover {
  background: @surface-alt;
  color: @foreground;
}

#mode {
  padding: 0 {{ .UI.HorizontalPadding }}px;
  margin: {{ div .UI.Padding 2 }}px;
  color: {{ contrast .Colors.Warning }};
  background: @warning;
  border-radius: {{ .UI.Radius }}px;
}

#window {
  color: @muted;
  padding: 0 {{ .UI.HorizontalPadding }}px;
}

#clock,
#cpu,
#memory,
#disk,
#battery,
#pulseaudio,
#network,
#backlight,
#tray {
  padding: 0 {{ .UI.HorizontalPadding }}px;
  margin: {{ div .UI.Padding 2 }}px 2px;
  background: @surface;
  border-radius: {{ .UI.Radius }}px;
}

#clock {
  color: @foreground;
  background: @surface-alt;
}

#cpu {
  color: @primary;
}

#memory {
  color: @secondary;
}

#disk {
  color: @accent;
}

#battery {
  color: @success;
}

#battery.warning {
  color: @warning;
}

#battery.critical:not(.charging) {
  color: {{ contrast .Colors.Error }};
  background: @error;
}

#pulseaudio {
  color: @accent;
}

#pulseaudio.muted {
  color: @muted;
}

#network.disconnected {
  color: @error;
}

tooltip {
  background: @surface;
  border: {{ .UI.BorderWidth }}px solid @primary;
  border-radius: {{ .UI.Radius }}px;
}

tooltip label {
  color: @foreground;
}
{{- with .Waybar.ExtraCSS }}

{{ trim . }}
{{- end }}
