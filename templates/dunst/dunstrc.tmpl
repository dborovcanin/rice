# Generated by Rice {{ .Version }} for generation {{ .Generation }}.
# Theme: {{ .Theme.Name }}

[global]
    monitor = 0
    follow = {{ .Dunst.Follow }}
    origin = {{ .Dunst.Origin }}
    offset = {{ .Dunst.Offset }}
    width = {{ .Dunst.Width }}
    height = {{ .Dunst.Height }}
    gap_size = {{ .Dunst.GapSize }}
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = {{ add .UI.Padding 6 }}
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = {{ .UI.Radius }}

    indicate_hidden = yes
    transparency = {{ sub 100 (scale .UI.Opacity 100) }}
    separator_height = {{ .UI.BorderWidth }}
    padding = {{ .UI.Padding }}
    horizontal_padding = {{ .UI.HorizontalPadding }}
    text_icon_padding = {{ .UI.HorizontalPadding }}
    frame_width = {{ .UI.BorderWidth }}
    frame_color = "{{ .Colors.Border }}"
    corner_radius = {{ .UI.Radius }}
    separator_color = frame

    sort = yes
    idle_threshold = 120

    font = {{ font (.Dunst.Font .Fonts.UIFamily) (.Dunst.Size .Fonts.UISize) }}
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    enable_recursive_icon_lookup = true
    icon_theme = "{{ .Icons.Theme }}"
{{- with .Icons.Paths }}
    icon_path = {{ join ":" . }}
{{- end }}
    min_icon_size = 32
    max_icon_size = {{ .Dunst.MaxIconSize }}

    sticky_history = yes
    history_length = 50

    title = Dunst
    class = Dunst

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "{{ .Colors.Surface }}"
    foreground = "{{ .Colors.Muted }}"
    frame_color = "{{ .Colors.Border }}"
    timeout = {{ .Dunst.TimeoutLow }}

[urgency_normal]
    background = "{{ .Colors.Surface }}"
    foreground = "{{ .Colors.Foreground }}"
    frame_color = "{{ .Colors.Primary }}"
    timeout = {{ .Dunst.TimeoutNormal }}

[urgency_critical]
    background = "{{ .Colors.Error }}"
    foreground = "{{ contrast .Colors.Error }}"
    frame_color = "{{ .Colors.Warning }}"
    timeout = {{ .Dunst.TimeoutCritical }}
{{- with .Dunst.Extra }}

{{ trim . }}
{{- end }}
