### Outputs
{{ range .Sway.Outputs }}
output {{ .Name }} {
{{- if .Disabled }}
    disable
{{- else }}
{{- with .Resolution }}
    resolution {{ . }}
{{- end }}
{{- with .Position }}
    position {{ . }}
{{- end }}
    scale {{ float .Scale }}
{{- with .Transform }}
    transform {{ . }}
{{- end }}
{{- if .Wallpaper }}
    bg {{ .Wallpaper }} {{ $.Sway.WallpaperMode }}
{{- else if $.Sway.Wallpaper }}
    bg $wallpaper {{ $.Sway.WallpaperMode }}
{{- end }}
{{- end }}
}
{{- end }}

### Input

input type:keyboard {
    xkb_layout "{{ .Sway.Keyboard.Layout }}"
{{- with .Sway.Keyboard.Variant }}
    xkb_variant "{{ . }}"
{{- end }}
{{- with .Sway.Keyboard.Options }}
    xkb_options "{{ . }}"
{{- end }}
{{- if gt .Sway.Keyboard.RepeatDelay 0 }}
    repeat_delay {{ .Sway.Keyboard.RepeatDelay }}
{{- end }}
{{- if gt .Sway.Keyboard.RepeatRate 0 }}
    repeat_rate {{ .Sway.Keyboard.RepeatRate }}
{{- end }}
}

input type:touchpad {
    tap {{ if .Sway.Touchpad.Tap }}enabled{{ else }}disabled{{ end }}
{{- with .Sway.Touchpad.TapButtonMap }}
    tap_button_map {{ . }}
{{- end }}
    natural_scroll {{ if .Sway.Touchpad.NaturalScroll }}enabled{{ else }}disabled{{ end }}
    dwt {{ if .Sway.Touchpad.DisableWhileTyping }}enabled{{ else }}disabled{{ end }}
    middle_emulation {{ if .Sway.Touchpad.MiddleEmulation }}enabled{{ else }}disabled{{ end }}
    drag_lock {{ if .Sway.Touchpad.DragLock }}enabled{{ else }}disabled{{ end }}
{{- with .Sway.Touchpad.AccelProfile }}
    accel_profile {{ . }}
{{- end }}
{{- if ne .Sway.Touchpad.PointerAccel 0.0 }}
    pointer_accel {{ float .Sway.Touchpad.PointerAccel }}
{{- end }}
}

seat seat0 xcursor_theme {{ .Cursor.Theme }} {{ .Cursor.Size }}

