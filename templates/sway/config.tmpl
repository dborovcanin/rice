### Modes
{{ range $mode := .Sway.Modes }}
mode "{{ $mode.Name }}" {
{{- range $mode.Bindings }}
    bindsym {{ .Keys }} {{ .Command }}{{ if hasPrefix "exec" .Command }}, mode "default"{{ end }}
{{- end }}
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
{{- with $mode.Enter }}
bindsym {{ . }} mode "{{ $mode.Name }}"
{{- end }}
{{ end }}

