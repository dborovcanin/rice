{{- end }}
{{- if .Sway.Idle.Enabled }}

exec swayidle -w \
{{- if gt .Sway.Idle.LockAfter 0 }}
    timeout {{ .Sway.Idle.LockAfter }} '$lock' \
{{- end }}
{{- if gt .Sway.Idle.ScreenOff 0 }}
    timeout {{ .Sway.Idle.ScreenOff }} 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
{{- end }}
{{- if gt .Sway.Idle.SleepAfter 0 }}
    timeout {{ .Sway.Idle.SleepAfter }} 'systemctl suspend' \
{{- end }}
{{- if .Sway.Idle.LockOnSleep }}
    before-sleep '$lock'
{{- end }}
{{- end }}
