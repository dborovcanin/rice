### Startup

# export session environment
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway
# clipboard history
exec wl-paste --watch cliphist store --max-items=5000
exec kdeconnectd
exec waybar
exec dunst
exec foot --server

exec swayidle -w \
    timeout 300 '$lock' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep '$lock'
