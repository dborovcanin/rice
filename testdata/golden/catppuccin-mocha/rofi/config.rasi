/* Generated by Rice 0.1.0 for generation 1. */
/* Theme: catppuccin-mocha */

configuration {
    modes: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "Run";
    terminal: "footclient";
    font: "Inter 11";
    drun-display-format: "{name}";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    background:      #1e1e2e;
    background-alt:  #313244;
    surface:         #45475a;
    foreground:      #cdd6f4;
    muted:           #6c7086;
    primary:         #89b4fa;
    secondary:       #cba6f7;
    urgent:          #f38ba8;
    on-primary:      #000000;
    transparent:     rgba(0,0,0,0%);
}

window {
    width:            30%;
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    border:           2px;
    border-color:     #89b4fa;
    border-radius:    8px;
    background-color: @background;
    cursor:           "default";
}

mainbox {
    enabled:  true;
    spacing:  0px;
    padding:  12px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    enabled:          true;
    spacing:          12px;
    padding:          6px 12px;
    margin:           0px 0px 6px 0px;
    border-radius:    8px;
    background-color: @background-alt;
    text-color:       @foreground;
    children:         [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color:       @primary;
}

entry {
    background-color:      transparent;
    text-color:            @foreground;
    cursor:                text;
    placeholder:           "Search";
    placeholder-color:     @muted;
}

listview {
    enabled:          true;
    lines:            10;
    columns:          1;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    spacing:          3px;
    background-color: transparent;
    text-color:       @foreground;
}

element {
    enabled:          true;
    spacing:          12px;
    padding:          6px 12px;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element selected.normal {
    background-color: @primary;
    text-color:       @on-primary;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @background;
}

element-icon {
    size:             24px;
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

message {
    background-color: transparent;
    margin:           6px 0px 0px 0px;
}

textbox {
    padding:          6px 12px;
    border-radius:    8px;
    background-color: @background-alt;
    text-color:       @foreground;
    vertical-align:   0.5;
}

error-message {
    padding:          12px;
    border-radius:    8px;
    background-color: @background;
    text-color:       @urgent;
}
