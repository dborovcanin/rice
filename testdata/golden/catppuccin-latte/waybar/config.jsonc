// Generated by Rice 0.1.0 for generation 1.
// Theme: catppuccin-latte — powerline
//
// The arrows are modules rather than shapes, because CSS cannot cut a corner
// off a Waybar module: each one is a glyph the stylesheet colours to match the
// segment beside it. One follows every module on the left, one leads every
// module on the right, and the centre group is capped at both ends.
//
// Spacing is zero whatever the configuration says: an arrow with a gap beside
// it stops being an arrow.
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "modules-left": [
    "sway/workspaces", "custom/right-arrow",
    "sway/mode", "custom/right-arrow"
  ],
  "modules-center": [
    "custom/left-arrow", "sway/window",
    "custom/right-arrow"
  ],
  "modules-right": [
    "custom/left-arrow", "pulseaudio",
    "custom/left-arrow", "cpu",
    "custom/left-arrow", "memory",
    "custom/left-arrow", "disk",
    "custom/left-arrow", "battery",
    "custom/left-arrow", "clock",
    "custom/left-arrow", "tray"
  ],
  "custom/left-arrow": {
    "format": "",
    "tooltip": false
  },
  "custom/right-arrow": {
    "format": "",
    "tooltip": false
  },
  "battery": {
    "format": " {capacity}%",
    "format-charging": " {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "states": {
      "critical": 15,
      "warning": 30
    }
  },
  "clock": {
    "format": " {:%H:%M}",
    "format-alt": " {:%a %d %b %Y}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 5
  },
  "disk": {
    "format": " {percentage_used}%",
    "interval": 60,
    "path": "/"
  },
  "memory": {
    "format": " {percentage}%",
    "interval": 5
  },
  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": " muted",
    "on-click": "pavucontrol",
    "scroll-step": 5
  },
  "sway/window": {
    "max-length": 60
  },
  "sway/workspaces": {
    "all-outputs": false,
    "disable-scroll": true
  },
  "tray": {
    "spacing": 8
  }
}
