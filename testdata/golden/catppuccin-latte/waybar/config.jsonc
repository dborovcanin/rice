// Generated by Rice 0.1.0 for generation 1.
// Theme: catppuccin-latte
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "modules-left": ["sway/workspaces","sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["pulseaudio","cpu","memory","disk","battery","clock","tray"],
  "battery": {
    "format": " {capacity}%",
    "format-charging": " {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "states": {
      "critical": 15,
      "warning": 30
    }
  },
  "clock": {
    "format": " {:%H:%M}",
    "format-alt": " {:%a %d %b %Y}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 5
  },
  "disk": {
    "format": " {percentage_used}%",
    "interval": 60,
    "path": "/"
  },
  "memory": {
    "format": " {percentage}%",
    "interval": 5
  },
  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": " muted",
    "on-click": "pavucontrol",
    "scroll-step": 5
  },
  "sway/window": {
    "max-length": 60
  },
  "sway/workspaces": {
    "all-outputs": false,
    "disable-scroll": true
  },
  "tray": {
    "spacing": 8
  }
}
