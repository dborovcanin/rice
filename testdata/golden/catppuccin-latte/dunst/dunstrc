# Generated by Rice 0.1.0 for generation 1.
# Theme: catppuccin-latte

[global]
    monitor = 0
    follow = mouse
    origin = top-center
    offset = 0x10
    width = 420
    height = 200
    gap_size = 10
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 12
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 8

    indicate_hidden = yes
    transparency = 3
    separator_height = 2
    padding = 6
    horizontal_padding = 12
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#ccd0da"
    corner_radius = 8
    separator_color = frame

    sort = yes
    idle_threshold = 120

    font = Inter 11
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Light"
    min_icon_size = 32
    max_icon_size = 64

    sticky_history = yes
    history_length = 50

    title = Dunst
    class = Dunst

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#e6e9ef"
    foreground = "#8c8fa1"
    frame_color = "#ccd0da"
    timeout = 5

[urgency_normal]
    background = "#e6e9ef"
    foreground = "#4c4f69"
    frame_color = "#1e66f5"
    timeout = 5

[urgency_critical]
    background = "#d20f39"
    foreground = "#ffffff"
    frame_color = "#df8e1d"
    timeout = 0
